final class SallaPushNotifications
SallaPushNotifications.canRequestPermission() -> Future<bool>
SallaPushNotifications.clearAll() -> Future<void>
SallaPushNotifications.forwardApnsToken(String apnsToken) -> Future<void>
SallaPushNotifications.isSallaPushNotification(Map<String, Object?> payload) -> Future<bool>
SallaPushNotifications.onClick -> Stream<SallaPushClickEvent> [getter]
SallaPushNotifications.onPermissionChange -> Stream<bool> [getter]
