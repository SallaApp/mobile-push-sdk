abstract final class SallaPush
SallaPush.appId -> Future<String?> [static getter]
SallaPush.debug -> SallaPushDebug [static final]
SallaPush.initialize(String appId, {SallaPushConfig config = const SallaPushConfig()}) -> Future<void> [static]
SallaPush.isInitialized -> Future<bool> [static getter]
SallaPush.login({required String externalId, required String identityToken}) -> Future<void> [static]
SallaPush.logout() -> Future<void> [static]
SallaPush.migration -> SallaPushMigration [static final]
SallaPush.notifications -> SallaPushNotifications [static final]
SallaPush.sdkVersion -> Future<String> [static getter]
SallaPush.setConsentGiven(bool given) -> Future<void> [static]
SallaPush.setConsentRequired(bool required) -> Future<void> [static]
SallaPush.user -> SallaPushUser [static final]
enum SallaPushApnsEnvironment { automatic, sandbox, production }
final class SallaPushClickEvent
SallaPushClickEvent.notification -> SallaPushNotification [final]
SallaPushClickEvent.result -> SallaPushClickResult [final]
SallaPushClickEvent.toString() -> String [@override]
final class SallaPushClickResult
SallaPushClickResult.actionId -> String? [final]
SallaPushClickResult.toString() -> String [@override]
SallaPushClickResult.url -> String? [final]
final class SallaPushConfig
SallaPushConfig.appVersion -> String? [final]
SallaPushConfig.autoClearBadge -> bool? [final]
SallaPushConfig.autoUpdateBadge -> bool? [final]
SallaPushConfig.clearTagsOnLogout -> bool? [final]
SallaPushConfig.ios -> SallaPushIosConfig [final]
SallaPushConfig.logLevel -> SallaPushLogLevel? [final]
SallaPushConfig.new({this.logLevel, this.appVersion, this.clearTagsOnLogout, this.requiresUserConsent, this.openLaunchUrls, this.autoClearBadge, this.autoUpdateBadge, this.ios = const SallaPushIosConfig()}) [const constructor]
SallaPushConfig.openLaunchUrls -> bool? [final]
SallaPushConfig.requiresUserConsent -> bool? [final]
final class SallaPushDebug
SallaPushDebug.logLevel -> Future<SallaPushLogLevel> [getter]
SallaPushDebug.setLogHandler(SallaPushLogLevel level, void Function(SallaPushLogEntry entry)? handler) -> Future<void>
SallaPushDebug.setLogLevel(SallaPushLogLevel level) -> Future<void>
final class SallaPushIosConfig
SallaPushIosConfig.apnsEnvironment -> SallaPushApnsEnvironment? [final]
SallaPushIosConfig.appGroupIdentifier -> String? [final]
SallaPushIosConfig.new({this.appGroupIdentifier, this.apnsEnvironment, this.registerForRemoteNotificationsOnInit}) [const constructor]
SallaPushIosConfig.registerForRemoteNotificationsOnInit -> bool? [final]
enum SallaPushIosPermissionStatus { notDetermined, denied, authorized, provisional, ephemeral }
final class SallaPushLogEntry
SallaPushLogEntry.category -> String [final]
SallaPushLogEntry.code -> String [final]
SallaPushLogEntry.level -> SallaPushLogLevel [final]
SallaPushLogEntry.message -> String [final]
SallaPushLogEntry.metadata -> Map<String, String> [final]
SallaPushLogEntry.timestamp -> DateTime [final]
SallaPushLogEntry.toString() -> String [@override]
enum SallaPushLogLevel { off, error, warn, info, debug, verbose }
enum SallaPushLoginFailure { tokenRejected, invalidRequest }
final class SallaPushMigration
SallaPushMigration.setDisplayCompatPayloads(bool display) -> Future<void>
final class SallaPushNotification
SallaPushNotification.additionalData -> Map<String, Object?> [final]
SallaPushNotification.androidNotificationId -> int? [final]
SallaPushNotification.badge -> int? [final]
SallaPushNotification.body -> String? [final]
SallaPushNotification.channelId -> String? [final]
SallaPushNotification.collapseId -> String? [final]
SallaPushNotification.display() -> Future<void>
SallaPushNotification.getBool(String key) -> bool?
SallaPushNotification.getInt(String key) -> int?
SallaPushNotification.getNumber(String key) -> num?
SallaPushNotification.getString(String key) -> String?
SallaPushNotification.imageUrl -> String? [final]
SallaPushNotification.launchUrl -> String? [final]
SallaPushNotification.notificationId -> String? [final]
SallaPushNotification.rawPayload -> Map<String, Object?> [final]
SallaPushNotification.sound -> String? [final]
SallaPushNotification.source -> SallaPushPayloadSource [final]
SallaPushNotification.subtitle -> String? [final]
SallaPushNotification.threadId -> String? [final]
