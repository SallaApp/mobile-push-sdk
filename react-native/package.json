{
  "name": "@salla.sa/mobile-push-react-native",
  "version": "1.0.0",
  "description": "SallaPush React Native SDK: push notifications for the React Native and Expo apps of Salla stores, built on the native SallaPush SDKs.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "salla.sa-mobile-push-react-native-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "plugin/build/**",
    "plugin/templates/**",
    "app.plugin.js",
    "*.podspec",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!android/src/test",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!ios/build",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @salla.sa/mobile-push-react-native-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib plugin/build",
    "build": "bob build && tsc -p plugin",
    "prepack": "del-cli lib plugin/build && bob build && tsc -p plugin",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p plugin --noEmit && tsc -p plugin/__tests__",
    "test": "jest",
    "test:scripts": "node --test --test-reporter=tap \"scripts/__tests__/*.test.mjs\""
  },
  "keywords": [
    "react-native",
    "expo",
    "ios",
    "android",
    "push-notifications",
    "salla"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SallaApp/mobile-push-sdk.git",
    "directory": "react-native"
  },
  "author": "Salla",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SallaApp/mobile-push-sdk/issues"
  },
  "homepage": "https://github.com/SallaApp/mobile-push-sdk/tree/master/react-native#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "expo": "57.0.28",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "0.43.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "expo": ">=54.0.0",
    "react": "*",
    "react-native": ">=0.81.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNSallaPushSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "sa.salla.sallapush.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "RNSallaPush": "RNSallaPush"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "salla.sa-mobile-push-react-native-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/",
      "<rootDir>/plugin/build/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/example/",
      "<rootDir>/lib/",
      "<rootDir>/plugin/build/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "plugin/src/**/*.ts",
      "!src/NativeRNSallaPush.ts",
      "!src/**/__tests__/**",
      "!src/**/__mocks__/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "statements": 90,
        "functions": 90,
        "branches": 80
      }
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest"
    ],
    "version": "0.63.1"
  }
}
