exports[`serviceSource extends @react-native-firebase/messaging's service and calls SallaPush first 1`] = `
"// Generated by the @salla.sa/mobile-push-react-native config plugin on every prebuild.
package sa.salla.example

import com.google.firebase.messaging.RemoteMessage
import com.salla.push.SallaPush
import io.invertase.firebase.messaging.ReactNativeFirebaseMessagingService

class SallaPushMessagingService : ReactNativeFirebaseMessagingService() {
    override fun onMessageReceived(remoteMessage: RemoteMessage) {
        if (SallaPush.Notifications.handleFirebaseMessage(applicationContext, remoteMessage)) return
        super.onMessageReceived(remoteMessage)
    }

    override fun onNewToken(token: String) {
        SallaPush.Notifications.onNewToken(applicationContext, token)
        super.onNewToken(token)
    }
}
"
`;

